---
interface Props {
  title?: string;
}

const { title = 'clawkin — lives in your statusline' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{title}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --bg: #000;
    --bg-card: #0a0a0a;
    --fg: #e7e7e7;
    --dim: #6a6a6a;
    --dim2: #3d3d3d;
    --rule: #2a2a2a;
    --hi: #ffffff;
  }
  * { box-sizing: border-box; }
  html, body {
    background: var(--bg);
    color: var(--fg);
    font-family: 'JetBrains Mono', 'Menlo', 'Consolas', monospace;
    margin: 0; padding: 0;
    -webkit-font-smoothing: antialiased;
    font-size: 14px;
    line-height: 1.6;
  }

  nav {
    border-bottom: 1px dashed var(--rule);
    padding: 16px 5vw;
  }
  .nav-inner {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--dim);
  }
  .brand { color: var(--hi); font-weight: 500; letter-spacing: 0.5px; }
  .brand .version { color: var(--dim); margin-left: 8px; font-weight: 400; }
  .nav-links { display: flex; gap: 20px; }
  .nav-links a {
    color: var(--dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 0.15s, border-color 0.15s;
  }
  .nav-links a:hover { color: var(--hi); border-bottom-color: var(--dim); }

  body { min-height: 100vh; }
  .wrap {
    max-width: 880px;
    margin: 0 auto;
    padding: 8vh 5vw 6vh;
  }

  /* Hero with breathing clawkin */
  .hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
    margin: 0 0 30px;
  }
  .hero h1 {
    flex: 1;
    max-width: 620px;
    font-size: clamp(24px, 3.6vw, 36px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
    color: var(--hi);
  }
  .hero h1 span.line { display: block; }
  .hero h1 span.line.last { color: var(--fg); font-weight: 500; }

  .hero-clawkin {
    margin: 0;
    padding-top: 6px;
    color: var(--hi);
    font-family: inherit;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 1.5px;
    flex-shrink: 0;
    white-space: pre;
    animation: breathe 3.2s ease-in-out infinite;
    transform-origin: center center;
    user-select: none;
  }
  @keyframes breathe {
    0%, 100% { opacity: 0.82; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.028); }
  }

  /* Install bar */
  .install-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    padding: 13px 16px;
    margin: 0;
    font-size: 14px;
    max-width: 520px;
  }
  .install-bar .dollar { color: var(--dim); user-select: none; }
  .install-bar code {
    font-family: inherit;
    color: var(--hi);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .install-bar .caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    background: var(--fg);
    vertical-align: -2px;
    animation: blink 1s steps(1) infinite;
    margin-left: -10px;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .copy-btn {
    background: transparent;
    color: var(--dim);
    border: 1px solid var(--rule);
    padding: 5px 12px;
    border-radius: 3px;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }
  .copy-btn:hover { color: var(--hi); border-color: var(--dim); }
  .copy-btn.copied { color: var(--hi); border-color: var(--hi); }

  /* Window mockup, standalone */
  .demo-standalone {
    margin-top: 28px;
  }
  .window {
    background: var(--bg-card);
    border: 1px solid var(--rule);
    overflow: hidden;
    max-width: 100%;
  }
  .window-chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    background: #070707;
    border-bottom: 1px solid var(--rule);
  }
  .window-chrome .dot { width: 10px; height: 10px; border-radius: 50%; }
  .window-chrome .dot.r { background: #ff5f57; }
  .window-chrome .dot.y { background: #febc2e; }
  .window-chrome .dot.g { background: #28c840; }
  .window-chrome .title {
    flex: 1; text-align: center;
    color: var(--dim); font-size: 12px; letter-spacing: 0.5px;
  }
  .window-body {
    padding: 18px 20px 10px;
    font-size: 13.5px;
    line-height: 1.75;
    min-height: 240px;
  }
  .window-body .prompt { color: var(--dim); }
  .window-body .muted { color: var(--dim); }
  .window-body .hi { color: var(--hi); }
  .clawkin-mock {
    font-size: 12px; line-height: 1; color: var(--hi);
    letter-spacing: 1px; display: inline-block; margin: 4px 0;
  }
  .statusline {
    padding: 9px 16px;
    background: #030303;
    border-top: 1px solid var(--rule);
    color: var(--hi);
    font-size: 12.5px;
    letter-spacing: 1.2px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .statusline .left { display: flex; align-items: center; gap: 10px; }
  .statusline .ctx { color: var(--dim); letter-spacing: 0.8px; }

  /* Labeled section (leaderboard) */
  .section {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 36px;
    padding: 28px 0;
    border-top: 1px dashed var(--rule);
    margin-top: 0;
  }
  .section-label {
    color: var(--dim);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    padding-top: 4px;
    user-select: none;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 1px;
    background: var(--dim2);
    vertical-align: middle;
    margin-right: 8px;
  }

  /* Badge preview + snippet */
  .badge-preview {
    display: inline-flex;
    font-family: inherit;
    font-size: 13px;
    line-height: 1;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    letter-spacing: 0.5px;
    user-select: none;
  }
  .badge-preview .badge-left {
    background: #1c1c1c;
    color: var(--fg);
    padding: 8px 13px;
  }
  .badge-preview .badge-right {
    background: #0a0a0a;
    color: var(--hi);
    padding: 8px 13px;
    font-weight: 500;
    border-left: 1px solid var(--rule);
  }
  .badge-snippet {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    padding: 11px 14px;
    margin-top: 14px;
    font-size: 13px;
    max-width: 520px;
  }
  .badge-snippet code {
    font-family: inherit;
    color: var(--hi);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .section-hint {
    color: var(--dim);
    font-size: 12px;
    margin-top: 14px;
    line-height: 1.6;
  }

  /* Pact block — no wrapping section label, no bullets */
  .pact-block {
    padding: 28px 0;
    border-top: 1px dashed var(--rule);
  }
  .dual-bare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .dual-bare h3 {
    color: var(--dim);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0 0 16px;
  }
  .dual-bare p {
    color: var(--fg);
    line-height: 1.55;
    margin: 0 0 14px;
    font-size: 14px;
    max-width: 34ch;
  }
  .dual-bare p:last-child { margin-bottom: 0; }
  .dual-bare .col-left h3 { color: var(--hi); }
  .dual-bare .col-left p { color: var(--hi); }

  /* Footer */
  footer {
    margin-top: 20px;
    padding: 22px 0;
    border-top: 1px dashed var(--rule);
    color: var(--dim);
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 12px;
    align-items: center;
  }
  footer a { color: var(--dim); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 1px; }
  footer a:hover { color: var(--hi); border-bottom-color: var(--dim); }
  footer .spacer { flex: 1; }

  .hidden { display: none; }
  .fadein { animation: fadein 0.35s ease-out both; }
  @keyframes fadein { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: none; } }

  @media (max-width: 680px) {
    body { font-size: 13px; }
    .wrap { padding: 5vh 4vw 4vh; }
    .hero { flex-direction: column; gap: 18px; }
    .hero h1 { font-size: 22px; max-width: 100%; }
    .hero-clawkin { font-size: 10px; align-self: flex-start; padding-top: 0; }
    .section {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 24px 0;
    }
    .section-label { padding-top: 0; }
    .dual-bare {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .lead-row {
      grid-template-columns: 50px 1fr;
      gap: 8px;
    }
    .lead-row .lead-title, .lead-row .lead-meta {
      grid-column: 2;
      font-size: 12px;
    }
    .install-bar { font-size: 13px; }
    .copy-btn { padding: 4px 8px; font-size: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-clawkin { animation: none; opacity: 1; }
  }
</style>
</head>
<body>
<slot />
<script>
  import { inject } from '@vercel/analytics';
  inject();
</script>
</body>
</html>
