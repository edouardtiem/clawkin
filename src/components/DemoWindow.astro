---
const ascii = `   ▄▄▄▄▄▄▄▄
  ██▀▀▀▀▀▀██
  █ ▄█  █▄ █
  █ ▀▀  ▀▀ █
  ██▄▄▄▄▄▄██
   ▀▀▀██▀▀▀`;
---
<div class="demo-standalone hidden" id="demo-section">
  <div class="window">
    <div class="window-chrome">
      <span class="dot r"></span>
      <span class="dot y"></span>
      <span class="dot g"></span>
      <span class="title">~/projects/clawkin — claude code</span>
    </div>
    <div class="window-body">
      <div><span class="prompt">~ $ </span><span class="hi">claude</span></div>
      <div class="muted">starting claude code session...</div>
      <br>
      <div><span class="hi">claude </span><span class="muted">→ reading files, registering hooks...</span></div>
      <div><span class="hi">clawkin</span><span class="muted"> → clean session detected. feeding your clawkin.</span></div>
      <br>
      <pre class="clawkin-mock">{ascii}</pre>
      <br>
      <div class="muted">first level up → <span class="hi">L12</span>. your clawkin is shared worldwide at this level.</div>
    </div>
    <div class="statusline">
      <div class="left">
        <span>▣▤</span>
        <span>L12 · 3d streak</span>
      </div>
      <div class="ctx">claude-sonnet-4-6 · 34% ctx · $0.12</div>
    </div>
  </div>
</div>
